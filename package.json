{
  "name": "rust-agents-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "node scripts/start.mjs dev",
    "start": "node scripts/start.mjs release",
    "build": "node scripts/build.mjs",
    "frontend:dev": "corepack pnpm generated:check && vite",
    "frontend:build": "corepack pnpm generated:check && tsc --noEmit && vite build",
    "compile": "corepack pnpm generated:check && node scripts/cargo.mjs check --locked --workspace",
    "check": "node scripts/check.mjs check",
    "format": "oxfmt --ignore-path .prettierignore --ignore-path .gitignore --write src scripts .github/workflows/ci.yml package.json tsconfig.json tsr.config.json vite.config.ts .oxlintrc.json .oxfmtrc.json components.json index.html src-tauri/tauri.conf.json pnpm-workspace.yaml README.md docs/evidence && cargo fmt --all",
    "format:check": "oxfmt --ignore-path .prettierignore --ignore-path .gitignore --check src scripts .github/workflows/ci.yml package.json tsconfig.json tsr.config.json vite.config.ts .oxlintrc.json .oxfmtrc.json components.json index.html src-tauri/tauri.conf.json pnpm-workspace.yaml README.md docs/evidence && cargo fmt --all -- --check",
    "test": "node scripts/test-unit.mjs",
    "test:measure": "node scripts/test-unit.mjs --measure",
    "qualify:process": "node scripts/cargo.mjs test --locked -p workspace-supervisor --features process-qualification --test startup --test discovery -- --test-threads=1",
    "verify": "node scripts/check.mjs verify",
    "tauri": "tauri",
    "test:ui": "vitest run --maxWorkers=1",
    "lint": "oxlint src --max-warnings 0 --report-unused-disable-directives-severity warn",
    "generated:write": "node scripts/prepare-generated.mjs --write",
    "generated:check": "node scripts/prepare-generated.mjs --check",
    "verify:ci": "node scripts/check.mjs ci"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@xstate/react": "6.1.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.72.0",
    "p-queue": "10.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.21.0",
    "shiki": "^4.6.0",
    "tw-animate-css": "1.4.0",
    "xstate": "5.33.4",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/intent": "0.5.6",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "31.0.0",
    "oxc-transform-react": "0.156.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "intent": {
    "skills": [
      "@tanstack/react-router#react-router",
      "@tanstack/react-router#compositions/router-query",
      "@tanstack/router-plugin#router-plugin",
      "@tanstack/router-core#router-core",
      "@tanstack/router-core#router-core/data-loading",
      "@tanstack/router-core#router-core/navigation",
      "@tanstack/router-core#router-core/path-params",
      "@tanstack/router-core#router-core/search-params",
      "@tanstack/router-core#router-core/code-splitting",
      "@tanstack/router-core#router-core/not-found-and-errors",
      "@tanstack/router-core#router-core/type-safety"
    ]
  }
}
